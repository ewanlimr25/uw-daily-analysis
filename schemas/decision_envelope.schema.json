{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uw-daily-analysis/schemas/decision_envelope.schema.json",
  "title": "Decision Envelope",
  "description": "Machine-resolvable structured sidecar written beside each analyses/*.md report. Ported in spirit from claude-trading-agents schemas.py:FinalDecision, adapted to a multi-call daily/weekly book. /calibration-audit Phase 1 reads this instead of re-parsing report prose.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_date", "report_kind", "regime", "calls", "report_path"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "report_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "report_kind": {"type": "string", "enum": ["daily", "weekly"]},
    "iso_week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "regime": {"type": "string"},
    "vrp_classification": {"type": ["string", "null"]},
    "macro_snapshot_signals": {"type": ["object", "null"]},
    "macro_event_risk": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "date", "impact"],
        "properties": {
          "event": {"type": "string"},
          "date": {"type": "string"},
          "impact": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    },
    "watchlist_write_back": {"type": "array", "items": {"type": "string"}},
    "report_path": {"type": "string"},
    "calls": {
      "type": "array",
      "items": {"$ref": "#/$defs/call"}
    }
  },
  "$defs": {
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "horizon", "direction", "tier", "raw_score", "score_components", "dominant_signal_class", "final_size", "thesis", "invalidation"],
      "properties": {
        "ticker": {"type": "string"},
        "horizon": {"type": "string", "enum": ["0DTE", "swing", "LEAP", "weekly", "vol"]},
        "section": {"type": "string", "enum": ["0DTE", "swing_long", "swing_short", "leap", "leap_disqualified", "vol_long", "vol_short", "watch_only"]},
        "direction": {"type": "string", "enum": ["long", "short", "vol_long", "vol_short", "neutral"]},
        "tier": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "DROP"]},
        "raw_score": {"type": "integer"},
        "score_components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rubric_line", "points", "source_agent", "source_tool", "evidence"],
            "properties": {
              "rubric_line": {"type": "string"},
              "points": {"type": "integer"},
              "source_agent": {"type": "string"},
              "source_tool": {"type": "string"},
              "evidence": {"type": "string"}
            }
          }
        },
        "dominant_signal_class": {"type": "string"},
        "confluence_score": {"type": ["number", "null"]},
        "cum_premium_flow_30d": {"type": ["number", "string", "null"]},
        "cum_premium_flow_90d": {"type": ["number", "string", "null"]},
        "win_rate": {"type": ["number", "null"]},
        "win_rate_n": {"type": ["integer", "null"]},
        "win_rate_source": {"type": ["string", "null"], "enum": ["backtest", "fallback_proxy", "NA", null]},
        "pre_risk_size": {"type": ["string", "null"], "enum": ["full", "half", "starter", "skip", "error", null]},
        "final_size": {"type": "string", "enum": ["full", "half", "starter", "skip", "veto", "watch_only"]},
        "gate_verdicts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "regime": {"type": "string"},
            "vrp": {"type": "string"},
            "panic": {"type": "string"},
            "cluster": {"type": "string"},
            "sector": {"type": "string"},
            "event_risk": {"type": "string"},
            "fundamentals": {"type": "string"}
          }
        },
        "fundamentals_verdict": {"type": ["string", "null"], "enum": ["CONFIRM", "CAUTION", "VETO", "NA", null]},
        "debate_residual_confidence": {"type": ["number", "null"], "enum": [0.55, 0.65, 0.75, 0.85, 0.95, null]},
        "structure": {"type": ["string", "null"]},
        "entry_or_trigger": {"type": ["string", "null"]},
        "invalidation": {"type": "string"},
        "key_risks": {"type": "array", "items": {"type": "string"}},
        "thesis": {"type": "string"}
      }
    }
  }
}
