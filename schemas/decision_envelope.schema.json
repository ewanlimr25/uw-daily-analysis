{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uw-daily-analysis/schemas/decision_envelope.schema.json",
  "title": "Decision Envelope",
  "description": "Machine-resolvable structured sidecar written beside each report.md inside its per-id run folder (analyses/daily/<date>/decision.json or analyses/weekly/<iso-week>/decision.json). Ported in spirit from claude-trading-agents schemas.py:FinalDecision, adapted to a multi-call daily/weekly book. /calibration-audit Phase 1 reads this instead of re-parsing report prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_date",
    "report_kind",
    "regime",
    "calls",
    "report_path"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ]
    },
    "rubric_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Rubric era stamp (2026-06-12 audit P0.1 \u2014 rubric freeze). The dated version of the conviction rubric the calls were scored under (e.g. '2026-06-12'). Lets /calibration-audit stratify calls by rubric era mechanically instead of inferring from report_date. Optional/additive: absent on pre-1.3 envelopes."
    },
    "report_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "report_kind": {
      "type": "string",
      "enum": [
        "daily",
        "weekly"
      ]
    },
    "iso_week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "regime": {
      "type": "string"
    },
    "vrp_classification": {
      "type": [
        "string",
        "null"
      ]
    },
    "macro_snapshot_signals": {
      "type": [
        "object",
        "null"
      ]
    },
    "macro_event_risk": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "date",
          "impact"
        ],
        "properties": {
          "event": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "watchlist_write_back": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report_path": {
      "type": "string"
    },
    "next_session_gex": {
      "$ref": "#/$defs/next_session_gex"
    },
    "next_session_0dte_setup": {
      "$ref": "#/$defs/next_session_0dte_setup"
    },
    "breadth_cross_check": {
      "$ref": "#/$defs/breadth_cross_check"
    },
    "calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/call"
      }
    }
  },
  "$defs": {
    "breadth_cross_check": {
      "description": "ADVISORY (2026-05-27 fz-edge A2). Step-0 `fz breadth --group sector` cross-check vs the `uw` regime label, from a different data lineage. Prose-only / advisory: contributes 0 points and is deliberately top-level (NOT in calls[]). null when fz_available == false.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "advisory",
        "source"
      ],
      "properties": {
        "advisory": {
          "type": "boolean",
          "const": true
        },
        "source": {
          "type": "string"
        },
        "advancers": {
          "type": [
            "integer",
            "null"
          ]
        },
        "decliners": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pct_green": {
          "type": [
            "number",
            "null"
          ]
        },
        "divergence_flag": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "fz_context": {
      "description": "ADVISORY (2026-05-27 fz-edge A1/A5). Finviz short-interest / float / analyst context for a top-5 name, from scripts/fz_enrich.py via the fundamentals-gate. Contributes 0 to raw_score \u2014 the squeeze (C15) and analyst-divergence (C17) gates are registered but NOT yet live (gated on /calibration-audit). Short interest is the exchange semi-monthly settlement figure (~2-week lag).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "short_float_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "days_to_cover": {
          "type": [
            "number",
            "null"
          ]
        },
        "float_shares": {
          "type": [
            "number",
            "null"
          ]
        },
        "squeeze_pressure": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "LOW",
            "MODERATE",
            "HIGH",
            "unknown",
            null
          ]
        },
        "recom": {
          "type": [
            "number",
            "null"
          ]
        },
        "upside_to_target_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "rsi": {
          "type": [
            "number",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "distribution_flag": {
      "description": "ADVISORY (2026-05-30 meta-audit C28; schema_version >= 1.2). Direct-flow distribution counter-signal from `uw oi decrease-with-volume` on a long-thesis name \u2014 institutional positions being CLOSED (OI down on high volume) on the bullish side, the microstructure read of 'distribution dressed as accumulation' the fundamentals-gate otherwise only INFERS from Finnhub. Contributes 0 to raw_score AND 0 to tier_adjustment \u2014 it strengthens a CAUTION/VETO narrative in prose only. Promotes to a scored VETO-support line ONLY after /calibration-audit Phase 6 shows distribution-flagged names underperform the accumulation baseline by >=10pp on n>=15. null/absent when not evaluated; the 0-points invariant is structural (it never enters score_components).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "source_tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "closing_side": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "call",
            "put",
            "mixed",
            null
          ]
        },
        "closing_premium": {
          "type": [
            "number",
            "null"
          ]
        },
        "oi_decrease": {
          "type": [
            "integer",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "next_session_0dte_setup": {
      "description": "ADVISORY (schema_version >= 1.1). The \u00a72 next-session 0DTE premium-selling setup for SPY/QQQ, from scripts/zerodte_setup.py. Delta-neutral vol harvest sized by VIX and structured by the GEX vol-suppression read \u2014 NOT a directional bet (every directional signal backtested NO_GO). Like next_session_gex it is prose-only / advisory, deliberately OUT of calls[] so it contributes 0 points to any raw_score; the 0-points invariant is structural. NOT a guaranteed edge: the validation sample has no vol shock, so the short-vol left tail is unsampled.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "advisory",
        "as_of_eod_date",
        "indices"
      ],
      "properties": {
        "advisory": {
          "type": "boolean",
          "const": true
        },
        "as_of_eod_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "backtest_verdict": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "GO_PREMIUM_SELL_INTRADAY",
            "NO_GO_NO_EDGE",
            "INSUFFICIENT_SAMPLE",
            null
          ]
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "sell_premium"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "enum": [
                  "SPY",
                  "QQQ"
                ]
              },
              "sell_premium": {
                "type": "boolean"
              },
              "vol_state": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "LOW",
                  "MID",
                  "HIGH",
                  "UNKNOWN",
                  null
                ]
              },
              "vix": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "implied_move_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "expected_range_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "size_scalar": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "suggested_structure": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "entry_rule": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stand_aside_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "caution": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "next_session_gex": {
      "description": "ADVISORY (schema_version >= 1.1). The \u00a72 next-session dealer-gamma map for SPY/QQQ ONLY, derived from EOD open interest that persists overnight. Prose-only / advisory: it is NOT a backtested predictive signal (predictive validation accrues in /weekly-analysis) and contributes 0 points to any call's raw_score \u2014 it is deliberately kept OUT of calls[] so it cannot enter the conviction rubric. The 0-points invariant is therefore structural. `symbol` is constrained to SPY/QQQ to enforce the \u00a72 scope boundary.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "advisory",
        "as_of_eod_date",
        "indices"
      ],
      "properties": {
        "advisory": {
          "type": "boolean",
          "const": true
        },
        "as_of_eod_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "next_session_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "spot",
              "regime"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "enum": [
                  "SPY",
                  "QQQ"
                ]
              },
              "spot": {
                "type": "number"
              },
              "zero_gamma_level": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "zgl_reliable": {
                "type": "boolean"
              },
              "regime": {
                "type": "string",
                "enum": [
                  "POSITIVE",
                  "NEGATIVE",
                  "FULLY_NEGATIVE",
                  "FULLY_POSITIVE"
                ]
              },
              "total_gex": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "call_wall": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "put_wall": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "read": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "structure_bias": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "caveats": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "horizon",
        "direction",
        "tier",
        "raw_score",
        "score_components",
        "dominant_signal_class",
        "final_size",
        "thesis",
        "invalidation"
      ],
      "properties": {
        "ticker": {
          "type": "string"
        },
        "horizon": {
          "type": "string",
          "enum": [
            "0DTE",
            "swing",
            "LEAP",
            "weekly",
            "vol"
          ]
        },
        "section": {
          "type": "string",
          "enum": [
            "0DTE",
            "swing_long",
            "swing_short",
            "leap",
            "leap_disqualified",
            "vol_long",
            "vol_short",
            "watch_only"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "long",
            "short",
            "vol_long",
            "vol_short",
            "neutral"
          ]
        },
        "tier": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "DROP"
          ]
        },
        "raw_score": {
          "type": "integer"
        },
        "score_components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rubric_line",
              "points",
              "source_agent",
              "source_tool",
              "evidence"
            ],
            "properties": {
              "rubric_line": {
                "type": "string"
              },
              "points": {
                "type": "integer"
              },
              "source_agent": {
                "type": "string"
              },
              "source_tool": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "dominant_signal_class": {
          "type": "string"
        },
        "confluence_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "cum_premium_flow_30d": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "cum_premium_flow_90d": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "win_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "win_rate_uncapped": {
          "type": [
            "number",
            "null"
          ],
          "description": "2026-06-12 audit P2.3 — the raw class win-rate BEFORE the 0.69/0.80 N-conditional + absolute caps were applied at emission. Preserved as a structured field (it was previously only in audit_trail prose) so /calibration-audit reliability diagrams bin on the true quote instead of the cap point-masses at 0.69/0.80. The capped value used downstream stays in win_rate."
        },
        "win_rate_n": {
          "type": [
            "integer",
            "null"
          ]
        },
        "win_rate_source": {
          "type": [
            "string",
            "null"
          ],
          "description": "Provenance of win_rate. 2026-06-12 P0.3: backtest_clean = signal-backtest under the clean-query protocol (complete forward windows, pinned --top-n, market-wide per class); NA(substrate) = clean protocol could not complete. backtest / fallback_proxy are RETIRED pre-quarantine era values, kept only for pre-1.3 back-compat (substrate-contaminated — audits weight accordingly).",
          "enum": [
            "backtest_clean",
            "NA(substrate)",
            "backtest",
            "fallback_proxy",
            "NA",
            null
          ]
        },
        "pre_risk_size": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "full",
            "half",
            "starter",
            "skip",
            "error",
            null
          ]
        },
        "final_size": {
          "type": "string",
          "enum": [
            "full",
            "half",
            "starter",
            "skip",
            "veto",
            "watch_only"
          ]
        },
        "gate_verdicts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "regime": {
              "type": "string"
            },
            "vrp": {
              "type": "string"
            },
            "panic": {
              "type": "string"
            },
            "cluster": {
              "type": "string"
            },
            "sector": {
              "type": "string"
            },
            "event_risk": {
              "type": "string"
            },
            "fundamentals": {
              "type": "string"
            },
            "debate": {
              "type": "string"
            },
            "rubric_regime": {
              "type": "string",
              "description": "2026-06-12 P0.6 out-of-regime guard verdict"
            },
            "excess": {
              "type": "string",
              "description": "optional record of the C2 market-excess gate result as applied by the quant (downgrade-only)"
            }
          },
          "description": "Per-gate verdict strings (risk-monitor gate-output discipline, 2026-05-09 P0). 2026-06-12 P1.1: schema previously REJECTED the debate key (additionalProperties:false without it) \u2014 root cause of the debate verdict being recorded on 0/151 calls. On schema >=1.3 the validator requires all 9 keys on every non-DROP call."
        },
        "fundamentals_verdict": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "CONFIRM",
            "CAUTION",
            "VETO",
            "NA",
            null
          ]
        },
        "fz_context": {
          "$ref": "#/$defs/fz_context"
        },
        "distribution_flag": {
          "$ref": "#/$defs/distribution_flag"
        },
        "implied_move": {
          "type": [
            "number",
            "null"
          ],
          "description": "2026-06-20 audit C42: at-entry implied move (%) the vol structure is priced against, for vol rows (vol_long/vol_short/earnings_vol/high_iv_rank). Enables true IV-vs-RV outcome resolution; without it /calibration-audit falls back to the RV-direction proxy. Additive/optional, 0 rubric points. null when not a vol row or unavailable."
        },
        "dp_block_to_float_ratio": {
          "type": [
            "number",
            "null"
          ],
          "description": "2026-06-20 audit C43/C16-enabler: institutional dark-pool block size as a fraction of float_shares, for dark_pool_accumulation rows. Lets the C16 float-normalized promotion gate be tested. Additive/optional, 0 rubric points. null when N/A."
        },
        "insider_cluster_flag": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "2026-06-20 audit C43/C18-enabler: true when accumulation-hunter co-flagged a distinct-buyer insider cluster (fz insider-clusters). Lets the C18 3-way conjunction gate be tested. Additive/optional, 0 rubric points. null when not checked."
        },
        "debate_residual_confidence": {
          "type": [
            "number",
            "null"
          ],
          "enum": [
            0.55,
            0.65,
            0.75,
            0.85,
            0.95,
            null
          ]
        },
        "structure": {
          "type": [
            "string",
            "null"
          ]
        },
        "entry_or_trigger": {
          "type": [
            "string",
            "null"
          ]
        },
        "invalidation": {
          "type": "string"
        },
        "key_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "thesis": {
          "type": "string"
        },
        "realized_pnl_pct": {
          "type": [
            "number",
            "null"
          ],
          "description": "C3: realised P&L % once the call closes; populated by /calibration-audit from historical_trend/yahoo prices. null while open."
        },
        "payoff_ratio": {
          "type": [
            "number",
            "null"
          ],
          "description": "C3: avg_win/|avg_loss| (R) for the call's signal class; feeds the fractional-Kelly sizer."
        },
        "expectancy_pct": {
          "type": [
            "number",
            "null"
          ],
          "description": "C3: per-trade expected value % = W*avg_win - (1-W)*|avg_loss|."
        },
        "kelly_fraction": {
          "type": [
            "number",
            "null"
          ],
          "description": "C3: capped half-Kelly fraction, floored at 0. ADVISORY until tier x expectancy is monotone on n>=30 closed calls; the win-rate ladder is the live sizer below that."
        },
        "debate_residuals": {
          "type": [
            "object",
            "null"
          ],
          "description": "2026-06-12 P1.1: both debate residuals as a pair so the debate gate's discrimination can be measured. The scalar debate_residual_confidence (bull residual) is kept for backward compatibility.",
          "additionalProperties": false,
          "required": [
            "bull",
            "bear"
          ],
          "properties": {
            "bull": {
              "type": [
                "number",
                "null"
              ],
              "enum": [
                0.55,
                0.65,
                0.75,
                0.85,
                0.95,
                null
              ]
            },
            "bear": {
              "type": [
                "number",
                "null"
              ],
              "enum": [
                0.55,
                0.65,
                0.75,
                0.85,
                0.95,
                null
              ]
            }
          }
        },
        "market_excess": {
          "type": [
            "number",
            "null"
          ],
          "description": "2026-06-12 P1.1: the C2 market-excess (signal raw WR minus same-direction SPY over the same kept windows), surfaced per call instead of buried in audit_trail. Negative = beta, not edge."
        }
      }
    }
  }
}
