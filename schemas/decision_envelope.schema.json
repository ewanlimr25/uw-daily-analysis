{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uw-daily-analysis/schemas/decision_envelope.schema.json",
  "title": "Decision Envelope",
  "description": "Machine-resolvable structured sidecar written beside each analyses/*.md report. Ported in spirit from claude-trading-agents schemas.py:FinalDecision, adapted to a multi-call daily/weekly book. /calibration-audit Phase 1 reads this instead of re-parsing report prose.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_date", "report_kind", "regime", "calls", "report_path"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0", "1.1"]},
    "report_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "report_kind": {"type": "string", "enum": ["daily", "weekly"]},
    "iso_week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "regime": {"type": "string"},
    "vrp_classification": {"type": ["string", "null"]},
    "macro_snapshot_signals": {"type": ["object", "null"]},
    "macro_event_risk": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "date", "impact"],
        "properties": {
          "event": {"type": "string"},
          "date": {"type": "string"},
          "impact": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    },
    "watchlist_write_back": {"type": "array", "items": {"type": "string"}},
    "report_path": {"type": "string"},
    "next_session_gex": {"$ref": "#/$defs/next_session_gex"},
    "next_session_0dte_setup": {"$ref": "#/$defs/next_session_0dte_setup"},
    "calls": {
      "type": "array",
      "items": {"$ref": "#/$defs/call"}
    }
  },
  "$defs": {
    "next_session_0dte_setup": {
      "description": "ADVISORY (schema_version >= 1.1). The §2 next-session 0DTE premium-selling setup for SPY/QQQ, from scripts/zerodte_setup.py. Delta-neutral vol harvest sized by VIX and structured by the GEX vol-suppression read — NOT a directional bet (every directional signal backtested NO_GO). Like next_session_gex it is prose-only / advisory, deliberately OUT of calls[] so it contributes 0 points to any raw_score; the 0-points invariant is structural. NOT a guaranteed edge: the validation sample has no vol shock, so the short-vol left tail is unsampled.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["advisory", "as_of_eod_date", "indices"],
      "properties": {
        "advisory": {"type": "boolean", "const": true},
        "as_of_eod_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "backtest_verdict": {"type": ["string", "null"], "enum": ["GO_PREMIUM_SELL_INTRADAY", "NO_GO_NO_EDGE", "INSUFFICIENT_SAMPLE", null]},
        "indices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "sell_premium"],
            "properties": {
              "symbol": {"type": "string", "enum": ["SPY", "QQQ"]},
              "sell_premium": {"type": "boolean"},
              "vol_state": {"type": ["string", "null"], "enum": ["LOW", "MID", "HIGH", "UNKNOWN", null]},
              "vix": {"type": ["number", "null"]},
              "implied_move_pct": {"type": ["number", "null"]},
              "expected_range_pct": {"type": ["number", "null"]},
              "size_scalar": {"type": ["number", "null"]},
              "suggested_structure": {"type": ["string", "null"]},
              "entry_rule": {"type": ["string", "null"]},
              "stand_aside_reason": {"type": ["string", "null"]},
              "caution": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "next_session_gex": {
      "description": "ADVISORY (schema_version >= 1.1). The §2 next-session dealer-gamma map for SPY/QQQ ONLY, derived from EOD open interest that persists overnight. Prose-only / advisory: it is NOT a backtested predictive signal (predictive validation accrues in /weekly-analysis) and contributes 0 points to any call's raw_score — it is deliberately kept OUT of calls[] so it cannot enter the conviction rubric. The 0-points invariant is therefore structural. `symbol` is constrained to SPY/QQQ to enforce the §2 scope boundary.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["advisory", "as_of_eod_date", "indices"],
      "properties": {
        "advisory": {"type": "boolean", "const": true},
        "as_of_eod_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "next_session_date": {"type": ["string", "null"]},
        "indices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "spot", "regime"],
            "properties": {
              "symbol": {"type": "string", "enum": ["SPY", "QQQ"]},
              "spot": {"type": "number"},
              "zero_gamma_level": {"type": ["number", "null"]},
              "zgl_reliable": {"type": "boolean"},
              "regime": {"type": "string", "enum": ["POSITIVE", "NEGATIVE", "FULLY_NEGATIVE", "FULLY_POSITIVE"]},
              "total_gex": {"type": ["number", "null"]},
              "call_wall": {"type": ["number", "null"]},
              "put_wall": {"type": ["number", "null"]},
              "read": {"type": ["string", "null"]},
              "structure_bias": {"type": ["string", "null"]},
              "caveats": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "horizon", "direction", "tier", "raw_score", "score_components", "dominant_signal_class", "final_size", "thesis", "invalidation"],
      "properties": {
        "ticker": {"type": "string"},
        "horizon": {"type": "string", "enum": ["0DTE", "swing", "LEAP", "weekly", "vol"]},
        "section": {"type": "string", "enum": ["0DTE", "swing_long", "swing_short", "leap", "leap_disqualified", "vol_long", "vol_short", "watch_only"]},
        "direction": {"type": "string", "enum": ["long", "short", "vol_long", "vol_short", "neutral"]},
        "tier": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "DROP"]},
        "raw_score": {"type": "integer"},
        "score_components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rubric_line", "points", "source_agent", "source_tool", "evidence"],
            "properties": {
              "rubric_line": {"type": "string"},
              "points": {"type": "integer"},
              "source_agent": {"type": "string"},
              "source_tool": {"type": "string"},
              "evidence": {"type": "string"}
            }
          }
        },
        "dominant_signal_class": {"type": "string"},
        "confluence_score": {"type": ["number", "null"]},
        "cum_premium_flow_30d": {"type": ["number", "string", "null"]},
        "cum_premium_flow_90d": {"type": ["number", "string", "null"]},
        "win_rate": {"type": ["number", "null"]},
        "win_rate_n": {"type": ["integer", "null"]},
        "win_rate_source": {"type": ["string", "null"], "enum": ["backtest", "fallback_proxy", "NA", null]},
        "pre_risk_size": {"type": ["string", "null"], "enum": ["full", "half", "starter", "skip", "error", null]},
        "final_size": {"type": "string", "enum": ["full", "half", "starter", "skip", "veto", "watch_only"]},
        "gate_verdicts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "regime": {"type": "string"},
            "vrp": {"type": "string"},
            "panic": {"type": "string"},
            "cluster": {"type": "string"},
            "sector": {"type": "string"},
            "event_risk": {"type": "string"},
            "fundamentals": {"type": "string"}
          }
        },
        "fundamentals_verdict": {"type": ["string", "null"], "enum": ["CONFIRM", "CAUTION", "VETO", "NA", null]},
        "debate_residual_confidence": {"type": ["number", "null"], "enum": [0.55, 0.65, 0.75, 0.85, 0.95, null]},
        "structure": {"type": ["string", "null"]},
        "entry_or_trigger": {"type": ["string", "null"]},
        "invalidation": {"type": "string"},
        "key_risks": {"type": "array", "items": {"type": "string"}},
        "thesis": {"type": "string"},
        "realized_pnl_pct": {"type": ["number", "null"], "description": "C3: realised P&L % once the call closes; populated by /calibration-audit from historical_trend/yahoo prices. null while open."},
        "payoff_ratio": {"type": ["number", "null"], "description": "C3: avg_win/|avg_loss| (R) for the call's signal class; feeds the fractional-Kelly sizer."},
        "expectancy_pct": {"type": ["number", "null"], "description": "C3: per-trade expected value % = W*avg_win - (1-W)*|avg_loss|."},
        "kelly_fraction": {"type": ["number", "null"], "description": "C3: capped half-Kelly fraction, floored at 0. ADVISORY until tier x expectancy is monotone on n>=30 closed calls; the win-rate ladder is the live sizer below that."}
      }
    }
  }
}
