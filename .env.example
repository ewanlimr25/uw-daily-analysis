# Copy to .env (git-ignored) and fill in. Consumed by scripts/_env.py.
# Resolution order per key: process env -> this repo's .env -> sibling fallback.

# FRED (St. Louis Fed) macro snapshot — scripts/fred_macro.py
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# FINNHUB fundamentals enrichment — scripts/finnhub_enrich.py
# Free key: https://finnhub.io/dashboard
# Optional here: if unset, _env.py falls back to
# ~/Development/claude-trading-agents/.env (the canonical store).
FINNHUB_API_KEY=
